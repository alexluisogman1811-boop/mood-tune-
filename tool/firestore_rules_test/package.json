{
  "name": "moodscape-firestore-rules-test",
  "private": true,
  "type": "module",
  "description": "Checks firestore.rules in the local Firestore emulator.",
  "scripts": {
    "test": "firebase --config ../../firebase.json emulators:exec --only firestore --project demo-moodscape \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^15.34.1"
  }
}
