rules_version = '2';

// MoodScape users database. Paste into Firebase console › Firestore ›
// Rules (or deploy with the Firebase CLI). These rules are what keep the
// data safe: the app's own checks are only a convenience.
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's admin account(s). Must match ADMIN_EMAILS in the app
    // build, and the email must be confirmed (verified).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['alexluisogman1811@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // People see only their own record; the admin sees everyone.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Sign-up creates a Free record with no usage. Nobody can create
      // themselves as Premium.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['email', 'plan', 'premiumUntil', 'usageDate', 'usageCount',
              'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == 'free'
        && request.resource.data.premiumUntil == null
        && request.resource.data.usageDate == null
        && request.resource.data.usageCount == 0
        && request.resource.data.createdAt == request.time;

      // Users may only count one more playlist (today), never change their
      // plan. The admin may change plans.
      allow update: if isAdmin()
        || (isOwner(uid) && (countsOnePlaylist() || marksOpened()));

      // Users can delete their own account (PDPA); the admin can too.
      allow delete: if isOwner(uid) || isAdmin();
    }

    function countsOnePlaylist() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['usageDate', 'usageCount'])
        && after.usageDate is string
        && after.usageDate.size() == 10
        && (
          // Same day: exactly one more.
          (after.usageDate == before.usageDate
            && after.usageCount == before.usageCount + 1)
          // New day: starts again at one.
          || (after.usageDate != before.usageDate && after.usageCount == 1)
        );
    }

    // The day the app was last opened (date only), for active-user counts.
    function marksOpened() {
      let after = request.resource.data;
      return after.diff(resource.data).affectedKeys().hasOnly(['lastOpened'])
        && after.lastOpened is string
        && after.lastOpened.size() == 10;
    }

    // Sales recorded when the admin gives a plan; income reports.
    match /payments/{id} {
      allow read, write: if isAdmin();
    }

    // Weekly marketing numbers entered on the admin website.
    match /marketing/{week} {
      allow read, write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
